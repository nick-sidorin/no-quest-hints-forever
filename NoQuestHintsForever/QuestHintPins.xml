<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- A genuine Blizzard QuestPOIFrame, not a texture/icon marker. -->
    <QuestPOIFrame name="NQHQuestBlobPinTemplate" mixin="NQHQuestBlobPinMixin" virtual="true">
        <Scripts>
            <OnShow method="OnShow"/>
            <OnHide method="OnHide"/>
            <OnEvent method="OnEvent"/>
            <OnUpdate method="OnUpdate"/>
        </Scripts>
    </QuestPOIFrame>
    <!-- Full native Blizzard quest POI buttons, with their '?' / '...' styles. -->
    <Button name="NQHQuestMarkerPinTemplate" inherits="QuestPinTemplate" virtual="true"/>
</Ui>
