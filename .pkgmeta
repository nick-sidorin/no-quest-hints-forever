# CurseForge's own GitHub source packager.
# Keep the runtime addon flat in the release ZIP:
# NoQuestHintsForever/NoQuestHintsForever.toc
# NoQuestHintsForever/NoQuestHintsForever.lua
package-as: NoQuestHintsForever
enable-nolib-creation: no

ignore:
  - tests
  - scripts
  - .github
  - AGENTS.md
  - PROJECT_CONTEXT.md
  - README.md
  - CHANGELOG.md
  - CURSEFORGE_DESCRIPTION.md
  - LICENSE

move-folders:
  NoQuestHintsForever/NoQuestHintsForever: NoQuestHintsForever

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
